\date{2025-07-11T14:40:10Z}
\taxon{Definition}
\title{Continuation Semantics}
\author{vikraman}
\import{base-macros}
\import{latex-preamble}

\p{
  Let #{F\colon \cat{C}\op \to \cat{C}} be a self-adjoint on the right functor, #{\cat{C}(A, FB) \natiso \cat{C}(B, FA)}.
}

\p{
  This induces the following situation.
  \figure{
    \tex{\latex-preamble/diagram}{
      % https://q.uiver.app/#
      \begin{tikzcd}
	        && {\cat{C}\op} \\
	        &&&& {\cat{C}_V} \\
	        \\
	        {\cat{C}_N} \\
	        && {\cat{C}}
	        \arrow[""{name=0, anchor=center, inner sep=0}, "{F\bo}"{description}, curve={height=-12pt}, from=1-3, to=4-1]
	        \arrow[""{name=1, anchor=center, inner sep=0}, "F"{description}, curve={height=12pt}, from=1-3, to=5-3]
	        \arrow["{F\op\ff}"', hook, from=2-5, to=1-3]
	        \arrow[""{name=2, anchor=center, inner sep=0}, "{k_{F^2}}"{description}, curve={height=-12pt}, from=2-5, to=5-3]
	        \arrow[""{name=3, anchor=center, inner sep=0}, "{{(k_{F^2})}\op}"{description}, curve={height=-12pt}, from=4-1, to=1-3]
	        \arrow["{F\ff}"', hook, from=4-1, to=5-3]
	        \arrow[""{name=4, anchor=center, inner sep=0}, "{F\op}"{description}, curve={height=12pt}, from=5-3, to=1-3]
	        \arrow[""{name=5, anchor=center, inner sep=0}, "{F\op\bo}"{description}, curve={height=-12pt}, from=5-3, to=2-5]
	        \arrow["\dashv"{anchor=center, rotate=-25}, draw=none, from=3, to=0]
	        \arrow["\dashv"{anchor=center, rotate=-180}, draw=none, from=4, to=1]
	        \arrow["\dashv"{anchor=center, rotate=-27}, draw=none, from=5, to=2]
      \end{tikzcd}
    }
  }
}

\p{
  #{\cat{C}_{N}(A,B) = \cat{C}(FA,FB) \natiso \cat{C}(B,F^2A)}
}

\p{
  #{\cat{C}_{V}(A,B) = \cat{C}(FB,FA) \natiso \cat{C}(A,F^2B)}
}

\p{
  This induces #{F^2}, a monad on #{\cat{C}} and a comonad on #{\cat{C}\op}.
}

\subtree{
  \taxon{Example}
  \p{
    In any symmetric monoidal category #{(\cat{C}, \otimes, I)} with an exponentiating object #{R},
    the functor #{[(-), R]} is self-adjoint on the right. This induces a [continuation monad or
    double dualization monad](0003) on #{\cat{C}}.
  }
}

\subtree{
  \taxon{Example}
  \p{
    In any distributive category #{(\cat{C}, 0, 1, \times, +)} with an exponentiating object #{R},
    the functor #{[(-), R]} is self-adjoint on the right, and the full-image of each functor is a
    model of call-by-name and call-by-value classical logic, respectively,
    and their posetal truncations are Boolean algebras.
  }
}

\subtree{
  \taxon{Example}
  \p{
      In any (Lafont) model of classical linear logic #{\cat{L}},
      the category of coalgebras #{\cat{L^{!}}} is a distributive category,
      with an exponentiating object #{R = !\bot},
      with exponentials #{R^A = !A^\bot}.
  }
}