\import{base-macros}
\import{latex-preamble}

\p{
  This character #{\alpha} is rendered by KaTeX, and so is this:
  #{(-) \otimes A \dashv A^* \cotensor (-)}.
}

\p{
  This character \tex{}{$\alpha$} is rendered by LaTeX, and so is this:
  \tex{\latex-preamble/logic}{
    $(-) \otimes A \dashv A^* \parr (-)$
  }.
}

\p{Note a name conflict occurs with the use of two kinds of parr symbols.}

\p{
  This is a proof tree.
  \figure{
    \tex{\latex-preamble/logic}{
      \begin{prooftree}
        \hypo{ \Gamma, A &\vdash B }
        \infer1[$\to$-I]{ \Gamma &\vdash A\to B }
        \hypo{ \Gamma \vdash A }
        \infer2[$\to$-E]{ \Gamma \vdash B }
      \end{prooftree}
    }
  }
}

