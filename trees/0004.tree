\date{2025-07-29T21:04:57Z}
\title{System L}
\author{vikraman}
\import{base-macros}
\import{latex-preamble}

\def\llbmmt{\lambda\bar{\lambda}\mu\tilde{\mu}}

\p{
  The #{\llbmmt} calculus has
  \ul{
    \li{environments #{\Gamma}}
    \li{co-environments #{\Delta}}
    \li{command judgements #{\Gamma \vdash \Delta}}
    \li{term judgements #{\Gamma \vdash A \mid \Delta}}
    \li{context judgements #{\Gamma \mid A \vdash \Delta}}
  }
}

\p{
  The #{\llbmmt} calculus is interpreted using the [continuation monad](0003) #{K = R^{R^{\blank}}}.
}

\p{
  In call-by-value (CBV):
  \ul{
    \li{#{\Gamma} is interpreted as sums and #{\Delta} as products of types.}
    \li{The function type is interpreted as #{A \to R^{R^B}}, or #{R^{R^B \times A}}, or #{R^B \to R^A}.}
    \li{#{\Gamma \vdash \Delta} is interpreted as #{\Gamma \times R^\Delta \to R}.}
    \li{#{\Gamma \vdash A \mid \Delta} is interpreted as #{\Gamma \times R^\Delta \to KA}.}
    \ul{
      \li{Values #{\Gamma \vdash A \mid \Delta} are interpreted as #{\Gamma \times R^\Delta \to A}.}
    }
    \li{#{\Gamma \mid A \vdash \Delta} is interpreted as #{\Gamma \times R^\Delta \to R^A}.}
  }
}

\p{
  In call-by-name (CBN):
  \ul{
    \li{#{\Gamma} is interpreted as products and #{\Delta} as sums of types.}
    \li{The function type is interpreted as #{R^A \times B}.}
    \li{#{\Gamma \vdash \Delta} is interpreted as #{R^\Gamma \times \Delta \to R}.}
    \li{#{\Gamma \vdash A \mid \Delta} is interpreted as #{R^\Gamma \times \Delta \to R^A}.}
    \li{#{\Gamma \mid A \vdash \Delta} is interpreted as #{R^\Gamma \times \Delta \to KA}.}
    \ul{
      \li{Covalues #{\Gamma \mid A \vdash \Delta} are interpreted as #{R^\Gamma \times \Delta \to A}.}
    }
  }
}

\p{
  This induces an equational theory for fine-grained CBV #{\llbmmt} and fine-grained CBN #{\llbmmt},
  that I have yet to define.
}
