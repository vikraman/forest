\title{Base Macros}

\import{latex-preamble}

\def\proof[body]{
  \scope{
    \put\transclude/toc{false}
    \subtree{
      \taxon{Proof}
      \body
    }
  }
}

\def\To{\Rightarrow}

\def\cotensor{
  \mathbin{
    \htmlStyle{display:inline-block;transform:rotate(180deg);}{\And}
  }
}

% category theory
\def\cat[c]{#{\mathcal{\c}}}
\def\psh[c]{#{\widehat{\c}}}
\def\op{#{^\mathsf{op}}}

\def\natiso{#{\cong}}

\p{Some macros.}
